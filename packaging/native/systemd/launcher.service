[Unit]
Description=Loki Go privileged Job launcher
PartOf=loki-go.target
After=local-fs.target systemd-tmpfiles-setup.service
Requires=loki-go-secrets.service
After=loki-go-secrets.service
Before=loki-go-executor.service
ConditionPathExists=/run/docker.sock

[Service]
Type=notify
NotifyAccess=main
User=root
Group=workspace
EnvironmentFile=/etc/loki-go/identity.env
RuntimeDirectory=loki-go/launcher
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes
StateDirectory=loki-go/launcher
StateDirectoryMode=0700
LogsDirectory=loki-go/launcher
LogsDirectoryMode=0700
ExecStart=/opt/loki/bin/loki-launcher --config /etc/loki-go/config.toml --layout /etc/loki-go/launcher.json --execution-contract /usr/share/doc/loki/execution-contract.json
Restart=on-failure
RestartSec=2
UMask=0077
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
ReadOnlyPaths=/var/lib/loki-go/toolchains/generations
BindReadOnlyPaths=/srv/workspace/loki:/workspace
ReadWritePaths=/var/lib/loki-go/launcher /var/lib/loki-go/toolchains/refs /run/loki-go/launcher -/run/docker.sock
ReadWritePaths=/run/loki-go/secrets/jobs
InaccessiblePaths=/var/lib/loki-go/runtime /var/lib/loki-go/signing /etc/loki-go/token
InaccessiblePaths=/var/lib/loki-go/secrets /run/loki-go/secrets/private /run/loki-go/secrets/metadata /run/loki-go/secrets/admin /run/loki-go/secrets/inbox /run/loki-go/secrets/layout.json /etc/loki-go/secrets-deployment.json /etc/loki-go/secrets-admin.json
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
LockPersonality=yes
CapabilityBoundingSet=CAP_DAC_OVERRIDE
AmbientCapabilities=CAP_DAC_OVERRIDE
RestrictRealtime=yes
TasksMax=128
MemoryMax=512M
TimeoutStopSec=15
