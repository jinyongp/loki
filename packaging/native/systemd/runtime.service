[Unit]
Description=Loki Go platform runtime
PartOf=loki-go.target
After=local-fs.target systemd-tmpfiles-setup.service loki-go-signing-agent.service
Wants=loki-go-signing-agent.service
Before=loki-go-mcp.service

[Service]
Type=notify
NotifyAccess=main
User=root
Group=workspace
ExecStart=/opt/loki/bin/loki runtime --config /etc/loki-go/config.toml --layout /etc/loki-go/runtime.json
Restart=on-failure
RestartSec=2
RuntimeDirectory=loki-go/runtime
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes
StateDirectory=loki-go/runtime
StateDirectoryMode=0700
LogsDirectory=loki-go/runtime
LogsDirectoryMode=0700
UMask=0077
NoNewPrivileges=yes
PrivateDevices=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=read-only
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
BindPaths=/srv/workspace/loki:/workspace
ReadWritePaths=/srv/workspace/loki /var/lib/loki-go/runtime /var/lib/loki-go/runner /var/cache/loki-go/runner /var/tmp/loki-go/runner /var/tmp/loki-go/github /var/log/loki-go/runtime /run/loki-go -/run/docker.sock
ReadWritePaths=/var/lib/loki-go/runner-config /var/lib/loki-go/runner-gh-config /var/lib/loki-go/runner-data /var/lib/loki-go/runner-xdg-state /var/lib/loki-go/snapshots
ReadWritePaths=/var/cache/loki-go/runner-npm /var/cache/loki-go/runner-pnpm /var/cache/loki-go/runner-playwright /var/cache/loki-go/runner-go-build /var/cache/loki-go/runner-go-mod /var/cache/loki-go/runner-pip
InaccessiblePaths=/var/lib/loki-go/secrets /run/loki-go/secrets /etc/loki-go/secrets-deployment.json /etc/loki-go/secrets-admin.json
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
LockPersonality=yes
CapabilityBoundingSet=CAP_SETUID CAP_SETGID
AmbientCapabilities=CAP_SETUID CAP_SETGID
RestrictRealtime=yes
TasksMax=256
MemoryMax=2G
TimeoutStopSec=10
