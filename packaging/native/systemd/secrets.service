[Unit]
Description=Loki application value broker
PartOf=loki-go.target
Requires=loki-go-secrets-prepare.service
After=loki-go-secrets-prepare.service
Before=loki-go-mcp.service loki-go-launcher.service

[Service]
Type=notify
NotifyAccess=main
User=loki-secrets
Group=loki-secrets
# The broker may assign its own public metadata socket to this group. The
# empty root namespace exposes no workspace or other group-owned host data.
SupplementaryGroups=workspace
RootDirectory=/var/lib/loki-go/secrets-root
MountAPIVFS=yes
BindReadOnlyPaths=/opt/loki/bin/loki-secret-broker /opt/loki/bin/devtools /run/loki-go/secrets/layout.json
BindPaths=/run/loki-go/secrets
# The host-owned generation drop-in binds only the selected app generation.
ExecStart=/opt/loki/bin/loki-secret-broker --layout /run/loki-go/secrets/layout.json
Restart=on-failure
RestartSec=2
KillMode=control-group
UMask=0077
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
PrivateNetwork=yes
ProtectSystem=strict
ProtectHome=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ReadWritePaths=/run/loki-go/secrets /var/lib/loki-go/secrets
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictRealtime=yes
TasksMax=128
MemoryMax=512M
TimeoutStopSec=15
