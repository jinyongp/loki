[Unit]
Description=Prepare Loki app broker metadata and private tmpfs sockets
PartOf=loki-go.target
After=local-fs.target systemd-tmpfiles-setup.service
Before=loki-go-secrets.service

[Service]
Type=oneshot
RemainAfterExit=yes
Restart=on-failure
RestartSec=2
User=root
EnvironmentFile=/etc/loki-go/identity.env
RuntimeDirectory=loki-go
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
ExecStart=/opt/loki/bin/loki host prepare-secrets --uid ${SECRETS_UID} --gid ${SECRETS_GID} --agent-uid ${RUNNER_UID} --metadata-gid ${WORKSPACE_GID} --unit-directory= --overlay-directory=
UMask=0077
NoNewPrivileges=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/etc/loki-go /var/lib/loki-go/secrets /run/loki-go
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_OVERRIDE CAP_FOWNER
TasksMax=16
MemoryMax=128M
