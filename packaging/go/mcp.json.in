{
  "RuntimeSocket": "/run/loki-go/runtime/control.sock",
  "PortGuardSocket": "/run/loki-go/port-guard/control.sock",
  "BrowserSocket": "/run/loki-go/browser/control.sock",
  "RGPath": "/usr/bin/rg",
  "RuntimeUID": 0,
  "PortGuardUID": @RUNNER_UID@,
  "BrowserUID": @BROWSER_UID@,
  "GitTemplateRoots": ["/etc/loki-go"],
  "Environment": {
    "HOME": "/home/runner",
    "PATH": "/opt/loki/bin:/home/linuxbrew/.linuxbrew/bin:/usr/bin:/bin",
    "GIT_CONFIG_GLOBAL": "/etc/loki-go/gitconfig",
    "GIT_CONFIG_NOSYSTEM": "1",
    "SSH_AUTH_SOCK": "/run/loki-go/signing/agent.sock",
    "LANG": "C.UTF-8",
    "LC_ALL": "C.UTF-8"
  }
}
