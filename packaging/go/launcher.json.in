{
  "Socket": "/run/loki-go/launcher/control.sock",
  "SocketGID": @WORKSPACE_GID@,
  "ExecutorUID": @EXECUTOR_UID@,
  "StateDirectory": "/var/lib/loki-go/launcher",
  "DockerSocket": "/run/docker.sock",
  "DockerPeerUID": 0,
  "Image": "@JOB_IMAGE@",
  "GatewayImage": "@JOB_IMAGE@",
  "GatewayBinary": "/opt/loki/bin/loki",
  "GatewayExecutionContract": "/usr/share/doc/loki/execution-contract.json",
  "GatewayEgressPolicy": "/usr/share/doc/loki/egress-policy.json",
  "GatewayProxyPort": 18766,
  "GatewayMemoryBytes": 134217728,
  "GatewayPIDs": 64,
  "GatewayTmpfsBytes": 33554432,
  "Workspace": "/srv/workspace/loki",
  "ToolchainStore": "/var/lib/loki-go/toolchains",
  "WorkloadUID": @RUNNER_UID@,
  "WorkloadGID": @RUNNER_GID@,
  "MemoryBytes": 1073741824,
  "PIDs": 256,
  "TmpfsBytes": 67108864,
  "RunTimeoutSeconds": 86400,
  "ResultRetentionSeconds": 3600,
  "MaxJobs": 64,
  "MaxOutputBytes": 262144
}
