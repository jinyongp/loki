{
  "Socket": "/run/loki-go/runtime/control.sock",
  "StateDirectory": "/var/lib/loki-go/runtime",
  "InboxDirectory": "/var/lib/loki-go/runtime/inbox",
  "AuditPath": "/var/log/loki-go/runtime/audit.jsonl",
  "AgentUID": @RUNNER_UID@,
  "SocketGID": @WORKSPACE_GID@,
  "DevtoolsBinary": "/opt/loki/bin/devtools",
  "DevtoolsHome": "/var/lib/loki-go/runner",
  "Workspace": "/workspace",
  "DockerSocket": "/run/docker.sock",
  "SnapshotDirectory": "/var/lib/loki-go/runner/snapshots",
  "RunnerUID": @RUNNER_UID@,
  "RunnerGID": @RUNNER_GID@
}
