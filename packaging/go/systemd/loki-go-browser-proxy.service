[Unit]
Description=Loki Go browser network proxy
PartOf=loki-go.target
After=network.target loki-go-port-guard.service
Requires=loki-go-port-guard.service
Before=loki-go-browser.service

[Service]
Type=notify
NotifyAccess=main
DynamicUser=yes
SupplementaryGroups=workspace
EnvironmentFile=/etc/loki-go/identity.env
ExecStart=/opt/loki/bin/loki browser-proxy --port 18767 --execution-contract /usr/share/doc/loki/execution-contract.json --port-guard-socket /run/loki-go/port-guard/control.sock --port-guard-uid $RUNNER_UID
Restart=on-failure
RestartSec=2
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictRealtime=yes
TasksMax=128
MemoryMax=256M
