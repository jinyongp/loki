[Unit]
Description=Loki Go isolated Git signing agent
Before=loki-runtime.service loki-mcp.service

[Service]
Type=notify
NotifyAccess=main
User=root
Group=workspace
EnvironmentFile=/etc/loki/identity.env
RuntimeDirectory=loki/signing
RuntimeDirectoryMode=0750
ExecStart=/opt/loki/bin/loki signing-agent --private-socket /run/loki/signing/private.sock --public-socket /run/loki/signing/agent.sock --key /var/lib/loki/signing/id_ed25519 --runner-uid $RUNNER_UID --socket-gid $WORKSPACE_GID
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
ReadWritePaths=/run/loki/signing
ReadOnlyPaths=/var/lib/loki/signing/id_ed25519
RestrictAddressFamilies=AF_UNIX
LockPersonality=yes
CapabilityBoundingSet=CAP_SETUID CAP_SETGID
AmbientCapabilities=CAP_SETUID CAP_SETGID
RestrictRealtime=yes
TasksMax=32
MemoryMax=64M
TimeoutStopSec=5

[Install]
WantedBy=multi-user.target
