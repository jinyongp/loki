[Unit]
Description=Loki Go MCP server
Requires=loki-runtime.service loki-port-guard.service loki-browser.service loki-signing-agent.service
Wants=loki-egress-proxy.service
After=network.target loki-egress-proxy.service loki-port-guard.service loki-browser.service loki-signing-agent.service loki-runtime.service
ConditionPathExists=/etc/loki/config.toml
ConditionPathExists=/etc/loki/token
StartLimitIntervalSec=0

[Service]
Type=notify
NotifyAccess=main
User=runner
Group=workspace
WorkingDirectory=/workspace
Environment=LOKI_RUN_ROOT=/run/loki
Environment=LOKI_SOCKET_ATTEMPTS=150
Environment=LOKI_SOCKET_INTERVAL=0.2
ExecStartPre=/opt/loki/libexec/wait-for-loki-sockets
TimeoutStartSec=35
ExecStart=/opt/loki/bin/loki mcp --config /etc/loki/config.toml --layout /etc/loki/mcp.json --token-file /etc/loki/token --jwks-file /etc/loki/cloudflare-jwks.json
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=yes
PrivateDevices=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=read-only
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
BindPaths=/srv/workspace/loki:/workspace
ReadWritePaths=/srv/workspace/loki /var/log/loki/mcp
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictRealtime=yes
TasksMax=1024
MemoryMax=4G
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
