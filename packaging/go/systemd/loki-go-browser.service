[Unit]
Description=Loki Go isolated browser
PartOf=loki-go.target
After=network.target loki-go-browser-proxy.service
Requires=loki-go-browser-proxy.service
Before=loki-go-mcp.service
ConditionFileIsExecutable=/opt/loki/toolchain/bin/chromium

[Service]
Type=notify
NotifyAccess=main
User=loki-browser
Group=workspace
EnvironmentFile=/etc/loki-go/identity.env
RuntimeDirectory=loki-go/browser
RuntimeDirectoryMode=0750
StateDirectory=loki-go/browser
StateDirectoryMode=0700
WorkingDirectory=/var/lib/loki-go/browser
ExecStart=/opt/loki/bin/loki browser --socket /run/loki-go/browser/control.sock --agent-uid $RUNNER_UID --socket-gid $WORKSPACE_GID --chrome /opt/loki/toolchain/bin/chromium --profile /var/lib/loki-go/browser/profile --downloads /srv/workspace/loki/.loki-go/browser-downloads --proxy http://127.0.0.1:18767
Restart=on-failure
RestartSec=3
UMask=0007
NoNewPrivileges=yes
PrivateDevices=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/loki-go/browser /run/loki-go/browser /srv/workspace/loki/.loki-go/browser-downloads
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictRealtime=yes
TasksMax=512
MemoryMax=2G
TimeoutStopSec=15
