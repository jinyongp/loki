  "environment": {
    "HOME":"/home/runner",
    "GH_CONFIG_DIR":"/var/lib/loki/runner/gh-config",
    "XDG_CONFIG_HOME":"/var/lib/loki/runner/config",
    "XDG_DATA_HOME":"/var/lib/loki/runner/data",
