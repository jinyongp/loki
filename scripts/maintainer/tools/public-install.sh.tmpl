#!/bin/sh
set -eu

release='@@RELEASE@@'
release_url='https://github.com/jinyongp/loki/releases/download/v@@RELEASE@@'
bin_dir="$HOME/.local/bin"
management_root=''
source_dir=''
while [ "$#" -gt 0 ]; do
    case "$1" in
        --bin-dir|--root|--source-dir)
            [ "$#" -ge 2 ] || { echo "Missing value for $1" >&2; exit 2; }
            case "$1" in --bin-dir) bin_dir=$2 ;; --root) management_root=$2 ;; --source-dir) source_dir=$2 ;; esac
            shift 2 ;;
        *) echo "Unknown installer option: $1" >&2; exit 2 ;;
    esac
done
case "$(uname -s)" in Linux) target_os=linux ;; Darwin) target_os=darwin ;; *) echo 'Use install.ps1 on Windows.' >&2; exit 1 ;; esac
case "$(uname -m)" in x86_64|amd64) target_arch=amd64 ;; arm64|aarch64) target_arch=arm64 ;; *) echo 'Unsupported native architecture.' >&2; exit 1 ;; esac
if [ -z "$management_root" ]; then
    if [ "$target_os" = darwin ]; then management_root="$HOME/Library/Application Support/loki"; else management_root="${XDG_CONFIG_HOME:-$HOME/.config}/loki"; fi
fi
case "$bin_dir:$management_root" in *'
'*) echo 'Installation paths cannot contain line breaks.' >&2; exit 2 ;; esac
case "$bin_dir" in /*) ;; *) echo 'Bin directory must be absolute.' >&2; exit 2 ;; esac
case "$management_root" in /*) ;; *) echo 'Management root must be absolute.' >&2; exit 2 ;; esac
scratch=$(mktemp -d)
trap 'rm -rf "$scratch"' EXIT HUP INT TERM
pins="$scratch/pins"
cat > "$pins" <<'PINS'
@@PINS@@
PINS
fetch() {
    filename=$1
    expected=$(awk -v name="$filename" '$1 == name {print $2}' "$pins")
    [ -n "$expected" ] || { echo "Unsupported release target: $filename" >&2; exit 1; }
    echo "[loki] Downloading $filename..." >&2
    if [ -n "$source_dir" ]; then cp "$source_dir/$filename" "$scratch/$filename"; else curl -fL --retry 3 --connect-timeout 20 --max-time 1200 --progress-bar "$release_url/$filename" -o "$scratch/$filename"; fi
    if command -v sha256sum >/dev/null 2>&1; then actual=$(sha256sum "$scratch/$filename" | awk '{print $1}'); else actual=$(shasum -a 256 "$scratch/$filename" | awk '{print $1}'); fi
    [ "$actual" = "$expected" ] || { echo "Release SHA-256 mismatch: $filename" >&2; exit 1; }
}
archive="loki-manager-$release-$target_os-$target_arch.zip"
fetch "$archive"
echo '[loki] Installing native management command...' >&2
if command -v unzip >/dev/null 2>&1; then unzip -q "$scratch/$archive" -d "$scratch/manager"; else python3 -m zipfile -e "$scratch/$archive" "$scratch/manager"; fi
chmod 0755 "$scratch/manager/loki"
sh "$scratch/manager/install.sh" "$bin_dir" "$management_root"
loki="$bin_dir/loki"
if [ "$bin_dir" = "$HOME/.local/bin" ]; then
    for profile in "$HOME/.profile" "$HOME/.zprofile"; do
        if ! grep -q '^# Loki native command PATH$' "$profile" 2>/dev/null; then
            printf '\n# Loki native command PATH\nexport PATH="$HOME/.local/bin:$PATH"\n' >> "$profile"
        fi
    done
fi
"$loki" --root "$management_root" version
"$loki" --root "$management_root" doctor
echo "Loki CLI installed. Command: $loki"
echo 'Configure and add tools afterward with loki tools. Run loki --help to get started.'
