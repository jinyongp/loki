#!/usr/bin/python3
from __future__ import annotations

import argparse
import json
from pathlib import Path
import subprocess

ROOT = Path("/srv/workspace/loki").resolve()
STORE = Path("/var/log/loki/mcp/checkpoints")

parser = argparse.ArgumentParser(description="Inspect or restore Loki Git checkpoints")
subparsers = parser.add_subparsers(dest="action", required=True)
subparsers.add_parser("list")
show = subparsers.add_parser("show")
show.add_argument("checkpoint")
restore = subparsers.add_parser("restore")
restore.add_argument("checkpoint")
args = parser.parse_args()

def paths(checkpoint: str) -> tuple[Path, Path]:
    if len(checkpoint) != 64 or any(character not in "0123456789abcdef" for character in checkpoint):
        raise SystemExit("invalid checkpoint id")
    return STORE / f"{checkpoint}.json", STORE / f"{checkpoint}.patch"

if args.action == "list":
    for path in sorted(STORE.glob("*.json"), reverse=True):
        data = json.loads(path.read_text(encoding="utf-8"))
        print(f"{path.stem}\t{data['created_at']}\t{data['repository']}")
else:
    metadata_path, patch_path = paths(args.checkpoint)
    metadata = json.loads(metadata_path.read_text(encoding="utf-8"))
    if args.action == "show":
        print(json.dumps(metadata, ensure_ascii=False, indent=2))
    else:
        repository = (ROOT / metadata["repository"]).resolve()
        if ROOT not in (repository, *repository.parents):
            raise SystemExit("checkpoint repository escapes workspace")
        status = subprocess.run(["git", "-C", repository, "status", "--porcelain"], capture_output=True, text=True, check=True)
        if status.stdout:
            raise SystemExit("repository must be clean before restore")
        subprocess.run(["git", "-C", repository, "apply", "--binary", patch_path], check=True)
        print(f"restored tracked changes in {repository}")
        if metadata.get("untracked"):
            print("untracked file contents were not archived; names are available with show")
