#!/bin/sh
set -eu

test "$(id -u)" -eq 0

restore_tty() {
  stty echo 2>/dev/null || true
}
trap restore_tty EXIT HUP INT TERM

printf 'Cloudflare tunnel token: ' >&2
stty -echo
IFS= read -r token
stty echo
printf '\n' >&2
trap - EXIT HUP INT TERM

if test "${#token}" -lt 80; then
  echo 'Token is unexpectedly short.' >&2
  exit 1
fi
case "$token" in
  *[!A-Za-z0-9._=-]*)
    echo 'Token contains unsupported characters.' >&2
    exit 1
    ;;
esac

temporary=$(mktemp /etc/loki/cloudflared/token.env.XXXXXX)
trap 'rm -f "$temporary"' EXIT HUP INT TERM
printf 'TUNNEL_TOKEN=%s\n' "$token" > "$temporary"
chown root:loki-tunnel "$temporary"
chmod 0640 "$temporary"
mv "$temporary" /etc/loki/cloudflared/token.env
trap - EXIT HUP INT TERM
unset token

systemctl enable --now loki-cloudflared.service
systemctl --no-pager --full status loki-cloudflared.service
