Set-StrictMode -Version Latest
$ErrorActionPreference = "Stop"

$releaseTag = "@@LOKI_RELEASE_TAG@@"
$frontendSha256 = "@@LOKI_WINDOWS_FRONTEND_SHA256@@"
$frontendLength = [Int64]"@@LOKI_WINDOWS_FRONTEND_LENGTH@@"
$frontendAsset = "loki-windows-amd64.exe"
$releaseUrl = "https://github.com/jinyongp/loki/releases/download/$releaseTag/$frontendAsset"
$canonicalBin = Join-Path $env:LOCALAPPDATA "Programs\Loki\bin"

function Fail([string]$Message) {
    throw $Message
}

function Add-CurrentProcessPath([string]$Directory) {
    $parts = @($env:Path -split ';' | Where-Object { $_ })
    foreach ($part in $parts) {
        try {
            $left = [IO.Path]::GetFullPath($part).TrimEnd('\')
            $right = [IO.Path]::GetFullPath($Directory).TrimEnd('\')
            if ($left.Equals($right, [StringComparison]::OrdinalIgnoreCase)) {
                return
            }
        }
        catch {
            if ($part.Equals($Directory, [StringComparison]::OrdinalIgnoreCase)) {
                return
            }
        }
    }
    if ($env:Path) {
        $env:Path = "$Directory;$env:Path"
    }
    else {
        $env:Path = $Directory
    }
}

if (-not $env:LOCALAPPDATA) {
    Fail "LOCALAPPDATA is required for the Windows Loki frontend."
}
if ($frontendSha256 -notmatch '^[0-9a-f]{64}$' -or $frontendLength -le 0) {
    Fail "Windows Loki frontend release identity is invalid."
}

$tempRoot = Join-Path ([IO.Path]::GetTempPath()) ("loki-bootstrap-" + [Guid]::NewGuid().ToString("N"))
$frontend = Join-Path $tempRoot $frontendAsset
$bootstrapExitCode = 1

try {
    New-Item -ItemType Directory -Path $tempRoot -ErrorAction Stop | Out-Null

    $localFrontend = if ($env:LOKI_WINDOWS_FRONTEND_FILE) { $env:LOKI_WINDOWS_FRONTEND_FILE.Trim() } else { "" }
    if ($localFrontend) {
        if (-not (Test-Path -LiteralPath $localFrontend -PathType Leaf)) {
            Fail "LOKI_WINDOWS_FRONTEND_FILE does not exist: $localFrontend"
        }
        Write-Host "[Loki] Using local Windows frontend candidate."
        Copy-Item -LiteralPath $localFrontend -Destination $frontend -ErrorAction Stop
    }
    else {
        Write-Host "[Loki] Downloading Windows frontend $releaseTag..."
        Invoke-WebRequest -UseBasicParsing -Uri $releaseUrl -OutFile $frontend -ErrorAction Stop
    }

    $item = Get-Item -LiteralPath $frontend -Force -ErrorAction Stop
    if (-not $item -or $item.PSIsContainer -or ($item.Attributes -band [IO.FileAttributes]::ReparsePoint)) {
        Fail "Downloaded Windows Loki frontend is not a regular file."
    }
    if ([Int64]$item.Length -ne $frontendLength) {
        Fail "Downloaded Windows Loki frontend length does not match the accepted release."
    }
    $digest = (Get-FileHash -LiteralPath $frontend -Algorithm SHA256 -ErrorAction Stop).Hash.ToLowerInvariant()
    if (-not $digest.Equals($frontendSha256, [StringComparison]::Ordinal)) {
        Fail "Downloaded Windows Loki frontend SHA-256 does not match the accepted release."
    }

    Write-Host "[Loki] Installing verified Windows frontend and Loki appliance..."
    $previousErrorActionPreference = $ErrorActionPreference
    try {
        # Windows PowerShell 5.1 can promote native stderr to NativeCommandError
        # when ErrorActionPreference is Stop. The native exit code is authoritative.
        $ErrorActionPreference = "Continue"
        & $frontend "bootstrap" "install"
        $bootstrapExitCode = $LASTEXITCODE
    }
    finally {
        $ErrorActionPreference = $previousErrorActionPreference
    }

    if ($bootstrapExitCode -eq 0) {
        Add-CurrentProcessPath $canonicalBin
        Write-Host "[Loki] Installation complete. 'loki' is available in this PowerShell session."
    }
    else {
        Write-Host "[Loki] Verified Windows frontend exited with code $bootstrapExitCode." -ForegroundColor Red
    }
}
catch {
    Write-Host "[Loki] ERROR: $($_.Exception.Message)" -ForegroundColor Red
    $bootstrapExitCode = 1
}
finally {
    Remove-Item -LiteralPath $tempRoot -Recurse -Force -ErrorAction SilentlyContinue
    $global:LASTEXITCODE = $bootstrapExitCode
}
