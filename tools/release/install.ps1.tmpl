Set-StrictMode -Version Latest
$ErrorActionPreference = "Stop"

$releaseTag = "@@LOKI_RELEASE_TAG@@"
$applianceSha256 = "@@LOKI_WSL_SHA256@@"
$applianceLength = [Int64]"@@LOKI_WSL_LENGTH@@"
$applianceAsset = "loki-wsl-amd64.wsl"
$releaseUrl = "https://github.com/jinyongp/loki/releases/download/$releaseTag/$applianceAsset"
$minimumWSL = "2.4.4"

$distributionName = if ($env:LOKI_WSL_NAME) { $env:LOKI_WSL_NAME.Trim() } else { "loki-mcp" }
$installLocation = if ($env:LOKI_WSL_LOCATION) { $env:LOKI_WSL_LOCATION.Trim() } else { "" }
$autoStart = $env:LOKI_WSL_AUTOSTART -ne "0"
$localAppliance = if ($env:LOKI_WSL_APPLIANCE_FILE) { $env:LOKI_WSL_APPLIANCE_FILE.Trim() } else { "" }

$currentStage = "initializing"

function Step([string]$Message) {
    $script:currentStage = $Message
    Write-Host "[Loki] $Message"
}

function Fail([string]$Message) {
    throw $Message
}

function Invoke-NativeResult([string]$Executable, [string[]]$Arguments) {
    $stderrPath = Join-Path ([IO.Path]::GetTempPath()) ("loki-native-" + [Guid]::NewGuid().ToString("N") + ".stderr")
    $previousErrorActionPreference = $ErrorActionPreference
    try {
        # Windows PowerShell 5.1 can promote native stderr to NativeCommandError
        # when ErrorActionPreference is Stop. Capture stderr separately and make
        # the native process exit code authoritative instead.
        $ErrorActionPreference = "Continue"
        $stdout = @(& $Executable @Arguments 2> $stderrPath)
        $code = $LASTEXITCODE
        $stderr = if (Test-Path -LiteralPath $stderrPath) { [IO.File]::ReadAllText($stderrPath) } else { "" }
    }
    finally {
        $ErrorActionPreference = $previousErrorActionPreference
        Remove-Item -LiteralPath $stderrPath -Force -ErrorAction SilentlyContinue
    }
    [PSCustomObject]@{
        ExitCode = $code
        Stdout = ((($stdout -join [Environment]::NewLine) -replace "`0", "").Trim())
        Stderr = (($stderr -replace "`0", "").Trim())
    }
}

function Invoke-NativeCapture([string]$Executable, [string[]]$Arguments, [int[]]$AllowedExitCodes = @(0)) {
    $result = Invoke-NativeResult $Executable $Arguments
    if ($AllowedExitCodes -notcontains $result.ExitCode) {
        $detail = if ($result.Stderr) { $result.Stderr } else { $result.Stdout }
        Fail "$Executable exited with code $($result.ExitCode). $detail"
    }
    return $result.Stdout
}

try {
Step "Checking Windows and WSL prerequisites..."
if (-not (Get-Command wsl.exe -ErrorAction SilentlyContinue)) {
    Fail "WSL is required. Install WSL, then rerun this command."
}
if ($distributionName -notmatch '^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$') {
    Fail "LOKI_WSL_NAME must be 1-64 characters using letters, digits, dot, underscore, or hyphen."
}
if ($installLocation) {
    if (-not [IO.Path]::IsPathRooted($installLocation)) {
        Fail "LOKI_WSL_LOCATION must be an absolute Windows path."
    }
    if (Test-Path -LiteralPath $installLocation) {
        Fail "LOKI_WSL_LOCATION already exists: $installLocation"
    }
}

$help = Invoke-NativeCapture "wsl.exe" @("--help") @(-1, 0, 1)
foreach ($requiredOption in @("--from-file", "--name", "--no-launch")) {
    if (-not $help.Contains($requiredOption)) {
        Fail "WSL $minimumWSL or newer is required for custom .wsl distributions. Run 'wsl --update' manually, then retry."
    }
}

$existingRaw = Invoke-NativeCapture "wsl.exe" @("--list", "--quiet")
$existing = @($existingRaw -split '\r?\n' | ForEach-Object { $_.Trim() } | Where-Object { $_ })
if ($existing | Where-Object { $_.Equals($distributionName, [StringComparison]::OrdinalIgnoreCase) }) {
    Fail "A WSL distribution named '$distributionName' already exists. If it came from a previous Loki install attempt, inspect it with 'wsl -d $distributionName --user root -- /usr/local/bin/loki host doctor --system'. Loki will not remove it automatically; otherwise choose another name with LOKI_WSL_NAME."
}
$taskName = "Loki WSL ($distributionName)"
if ($autoStart -and (Get-ScheduledTask -TaskName $taskName -ErrorAction SilentlyContinue)) {
    Fail "Scheduled Task '$taskName' already exists."
}
Write-Host "[Loki] Preflight complete. Target distribution: $distributionName"

$tempRoot = Join-Path ([IO.Path]::GetTempPath()) ("loki-wsl-" + [Guid]::NewGuid().ToString("N"))
$appliance = Join-Path $tempRoot $applianceAsset
New-Item -ItemType Directory -Path $tempRoot | Out-Null
try {
    Step "Preparing Loki $releaseTag WSL appliance..."
    if ($localAppliance) {
        if (-not (Test-Path -LiteralPath $localAppliance -PathType Leaf)) {
            Fail "LOKI_WSL_APPLIANCE_FILE does not exist: $localAppliance"
        }
        Write-Host "[Loki] Using local appliance: $localAppliance"
        Copy-Item -LiteralPath $localAppliance -Destination $appliance
    } else {
        $applianceMiB = [Math]::Ceiling($applianceLength / 1MB)
        Write-Host "[Loki] Downloading $applianceAsset ($applianceMiB MiB)..."
        Invoke-WebRequest -UseBasicParsing -Uri $releaseUrl -OutFile $appliance
    }

    Step "Verifying WSL appliance integrity..."
    $file = Get-Item -LiteralPath $appliance
    if ($file.Length -ne $applianceLength) {
        Fail "Downloaded WSL appliance length does not match the accepted release."
    }
    $actualSha = (Get-FileHash -LiteralPath $appliance -Algorithm SHA256).Hash.ToLowerInvariant()
    if ($actualSha -ne $applianceSha256) {
        Fail "Downloaded WSL appliance SHA-256 does not match the accepted release."
    }
    Write-Host "[Loki] Appliance verification passed."

    Step "Registering WSL distribution '$distributionName'..."
    $installArgs = @("--install", "--from-file", $appliance, "--name", $distributionName, "--no-launch")
    if ($installLocation) {
        $installArgs += @("--location", $installLocation)
    }
    Invoke-NativeCapture "wsl.exe" $installArgs | Out-Null
    Write-Host "[Loki] WSL distribution registered."

    Step "Starting WSL and provisioning Docker + Loki runtime..."
    Write-Host "[Loki] This can take several minutes."
    $keepAlive = Start-Process -FilePath "$env:SystemRoot\System32\wsl.exe" -ArgumentList @("-d", $distributionName, "--exec", "/usr/bin/sleep", "infinity") -WindowStyle Hidden -PassThru

    $ready = $false
    for ($attempt = 0; $attempt -lt 300; $attempt++) {
        # Probe the systemd unit as the normal appliance user. This avoids
        # repeatedly opening a root WSL user session while first boot is still
        # converging; administrative calls are made only after provisioning.
        $probe = Invoke-NativeResult "wsl.exe" @("-d", $distributionName, "--exec", "/usr/bin/systemctl", "is-active", "--quiet", "loki-appliance-provision.service")
        if ($probe.ExitCode -eq 0) {
            $ready = $true
            break
        }
        if ($attempt -gt 0 -and ($attempt % 15) -eq 0) {
            Write-Host "[Loki]   First-boot provisioning is still running ($($attempt * 2)s elapsed)..."
        }
        Start-Sleep -Seconds 2
    }
    if (-not $ready) {
        $diagnosticResult = Invoke-NativeResult "wsl.exe" @("-d", $distributionName, "--user", "root", "--exec", "/usr/bin/journalctl", "-u", "loki-appliance-provision.service", "--no-pager", "-n", "80")
        $diagnostics = @($diagnosticResult.Stdout, $diagnosticResult.Stderr) | Where-Object { $_ }
        Fail "Loki appliance provisioning did not complete within 10 minutes. Service diagnostics:$([Environment]::NewLine)$($diagnostics -join [Environment]::NewLine)"
    }
    Write-Host "[Loki] First-boot provisioning complete."

    Step "Verifying Loki host health..."
    Invoke-NativeCapture "wsl.exe" @("-d", $distributionName, "--user", "root", "--exec", "/usr/local/bin/loki", "host", "status", "--system", "--json") | Out-Null
    Invoke-NativeCapture "wsl.exe" @("-d", $distributionName, "--user", "root", "--exec", "/usr/local/bin/loki", "host", "doctor", "--system") | Out-Null
    Write-Host "[Loki] Loki host health checks passed."

    Step "Reading MCP connection information..."
    $connectionRaw = Invoke-NativeCapture "wsl.exe" @("-d", $distributionName, "--user", "root", "--exec", "/usr/local/bin/loki", "host", "connection", "--system", "--json")
    $connection = $connectionRaw | ConvertFrom-Json
    $token = Invoke-NativeCapture "wsl.exe" @("-d", $distributionName, "--user", "root", "--exec", "/bin/cat", "/var/lib/loki/lifecycle/mcp-token")
    if (-not $token -or $token.Contains([Environment]::NewLine)) {
        Fail "Loki MCP token material is invalid."
    }

    Step "Writing protected Windows MCP connection files..."
    $stateDir = Join-Path $env:LOCALAPPDATA (Join-Path "Loki" $distributionName)
    New-Item -ItemType Directory -Path $stateDir -Force | Out-Null
    $identity = [Security.Principal.WindowsIdentity]::GetCurrent().Name
    Invoke-NativeCapture "icacls.exe" @($stateDir, "/inheritance:r", "/grant:r", "${identity}:(OI)(CI)(F)", "SYSTEM:(OI)(CI)(F)") | Out-Null

    $tokenFile = Join-Path $stateDir "mcp-token"
    $connectionFile = Join-Path $stateDir "connection.json"
    $utf8 = New-Object System.Text.UTF8Encoding($false)
    [IO.File]::WriteAllText($tokenFile, $token, $utf8)
    try {
        Invoke-NativeCapture "icacls.exe" @($tokenFile, "/inheritance:r", "/grant:r", "${identity}:(F)", "SYSTEM:(F)") | Out-Null
    }
    catch {
        Remove-Item -LiteralPath $tokenFile -Force -ErrorAction SilentlyContinue
        throw
    }

    $publicConnection = [ordered]@{
        endpoint = [string]$connection.endpoint
        transport = [string]$connection.transport
        authentication = "bearer-token-file"
        token_file = $tokenFile
        distribution = $distributionName
    }
    [IO.File]::WriteAllText($connectionFile, ($publicConnection | ConvertTo-Json -Depth 4), $utf8)
    Write-Host "[Loki] Windows MCP connection files are ready."

    Step "Configuring Windows startup integration..."
    if ($autoStart) {
        $taskAction = New-ScheduledTaskAction -Execute "$env:SystemRoot\System32\wsl.exe" -Argument "-d $distributionName --exec /usr/bin/sleep infinity"
        $taskTrigger = New-ScheduledTaskTrigger -AtLogOn -User $identity
        $taskSettings = New-ScheduledTaskSettingsSet -ExecutionTimeLimit ([TimeSpan]::Zero) -StartWhenAvailable -AllowStartIfOnBatteries -DontStopIfGoingOnBatteries
        Register-ScheduledTask -TaskName $taskName -Action $taskAction -Trigger $taskTrigger -Settings $taskSettings -Description "Keep the Loki WSL2 appliance running." -Force | Out-Null
        Write-Host "[Loki] Windows logon startup enabled."
    } else {
        Write-Host "[Loki] Windows logon startup disabled by LOKI_WSL_AUTOSTART=0."
    }

    Write-Host "[Loki] Installation complete."
    $global:LASTEXITCODE = 0
    Write-Host "  Release: $releaseTag"
    Write-Host "  WSL distribution: $distributionName"
    Write-Host "  MCP endpoint: $($publicConnection.endpoint)"
    Write-Host "  Connection file: $connectionFile"
    Write-Host "  Token file: $tokenFile"
}
finally {
    Remove-Item -LiteralPath $tempRoot -Recurse -Force -ErrorAction SilentlyContinue
}
}
catch {
    $global:LASTEXITCODE = 1
    Write-Host "[Loki] ERROR [$script:currentStage]: $($_.Exception.Message)" -ForegroundColor Red
}
